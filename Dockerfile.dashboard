# ═══════════════════════════════════════════════════════════
#  SecureScore HQ Dashboard — Streamlit (Docker)
# ═══════════════════════════════════════════════════════════
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-dashboard.txt .
RUN pip install --no-cache-dir -r requirements-dashboard.txt

COPY hq_dashboard.py .

EXPOSE 8501

ENTRYPOINT ["streamlit", "run", "hq_dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]
