# ═══════════════════════════════════════════════════════════
#  SecureScore Environment Variables (.env.example)
#  Copy to .env and fill in real values. NEVER commit .env!
# ═══════════════════════════════════════════════════════════

# ── Go BFF ────────────────────────────────────────────────
BFF_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_32CHARS
WEBHOOK_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_COPILOT_MODEL=llama-3.3-70b-versatile
DP_TOTAL_BUDGET=10.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── HQ Server ─────────────────────────────────────────────
HQ_BRANCH_API_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
HQ_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
HQ_PORT=5050
HQ_MIN_NODES=3
HQ_ROUND_INTERVAL=60
HQ_BYZANTINE_SIGMA=2.0

# ── mTLS Paths ────────────────────────────────────────────
MTLS_CA_CERT=certs/ca.crt
MTLS_HQ_CERT=certs/hq.crt
MTLS_HQ_KEY=certs/hq.key

# ── Edge Node ─────────────────────────────────────────────
# Each edge node should set its own branch cert paths:
# MTLS_BRANCH_CERT=certs/branch_kathmandu.crt
# MTLS_BRANCH_KEY=certs/branch_kathmandu.key
EDGE_BRANCH_NAME=kathmandu
EDGE_HQ_URL=https://127.0.0.1:5050

# ── Differential Privacy ─────────────────────────────────
DP_EPSILON=1.0
DP_CLIP_NORM=1.0

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_SUBMIT=10/minute

# ── Database (if bank_app needs one) ─────────────────────
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=securescore
# DB_USER=CHANGE_ME
# DB_PASSWORD=CHANGE_ME

# ═══════════════════════════════════════════════════════════
#  Core Banking Stack — Service Environment Variables
#  Copy relevant blocks to .env.auth / .env.banking / .env.ai
# ═══════════════════════════════════════════════════════════

# ── Auth Service (.env.auth) ──────────────────────────────
AUTH_SERVICE_PORT=8081
AUTH_SERVICE_ENV=development
AUTH_LOG_LEVEL=info
AUTH_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=86400
AUTH_DB_HOST=postgres-auth
AUTH_DB_PORT=5432
AUTH_DB_NAME=securescore_auth
AUTH_DB_USER=auth_svc
AUTH_DB_PASSWORD=CHANGE_ME_AUTH_DB_PASSWORD
AUTH_REDIS_HOST=redis
AUTH_REDIS_PORT=6379
AUTH_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
AUTH_BCRYPT_ROUNDS=12

# ── Banking Service (.env.banking) ───────────────────────
BANKING_SERVICE_PORT=8082
BANKING_SERVICE_ENV=development
BANKING_LOG_LEVEL=info
BANKING_DB_HOST=postgres-banking
BANKING_DB_PORT=5432
BANKING_DB_NAME=securescore_banking
BANKING_DB_USER=banking_svc
BANKING_DB_PASSWORD=CHANGE_ME_BANKING_DB_PASSWORD
AUDIT_DB_HOST=postgres-banking
AUDIT_DB_PORT=5432
AUDIT_DB_NAME=securescore_audit
AUDIT_DB_USER=audit_svc
AUDIT_DB_PASSWORD=CHANGE_ME_AUDIT_DB_PASSWORD
BANKING_REDIS_HOST=redis
BANKING_REDIS_PORT=6379
BANKING_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
BANKING_KAFKA_BROKERS=kafka:9092
BANKING_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# BANKING_KAFKA_SSL_CA_LOCATION=/run/secrets/kafka_ca.pem
# BANKING_KAFKA_SSL_CERT_LOCATION=/run/secrets/kafka_client.crt
# BANKING_KAFKA_SSL_KEY_LOCATION=/run/secrets/kafka_client.key
BANKING_AI_GRPC_HOST=ai
BANKING_AI_GRPC_PORT=50051
BANKING_JWT_PUBLIC_KEY_PATH=/run/secrets/auth_jwt_public.pem
BANKING_MAX_TRANSFER_LIMIT=10000000
BANKING_CURRENCY=NPR

# ── AI Inference Service (.env.ai) ────────────────────────
AI_SERVICE_PORT=8083
AI_GRPC_PORT=50051
AI_SERVICE_ENV=development
LOG_LEVEL=info
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP=ai-fraud-consumer
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SSL_CA_LOCATION=/run/secrets/kafka_ca.pem
# KAFKA_SSL_CERT_LOCATION=/run/secrets/kafka_client.crt
# KAFKA_SSL_KEY_LOCATION=/run/secrets/kafka_client.key
MODEL_PATH=/app/models/
FRAUD_MODEL_FILE=fraud_model_v2.joblib
ANOMALY_MODEL_FILE=anomaly_model_v1.joblib
# GRPC_TLS_CERT=/run/secrets/ai_grpc.crt
# GRPC_TLS_KEY=/run/secrets/ai_grpc.key
# GRPC_CA=/run/secrets/grpc_ca.pem

# ── Shared Infrastructure ─────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
POSTGRES_AUTH_PASSWORD=CHANGE_ME_AUTH_DB_PASSWORD
POSTGRES_BANKING_PASSWORD=CHANGE_ME_BANKING_DB_PASSWORD

# ── Observability ────────────────────────────────────────
SENTRY_DSN=
APP_ENV=development
GIT_SHA=
ARCHIVE_S3_BUCKET=securescore-audit-archive
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WEBHOOK_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GIT_SHA=

# SMTP — welcome mail on user creation. Gmail needs an app password, not the
# account password (myaccount.google.com/apppasswords). Leave SMTP_HOST empty
# to disable sending; user creation still succeeds.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
