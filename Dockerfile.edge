# ═══════════════════════════════════════════════════════════
#   SecureScore Edge Node API — Federated Branch Client (Docker)
#   Security-hardened: non-root, read-only FS, no-new-privileges
# ═══════════════════════════════════════════════════════════
#
# Build:
#   docker build -t securescore-edge -f Dockerfile.edge .
#
# Run (example — Pokhara branch):
#   docker run --read-only \
#     --tmpfs /tmp:noexec,nosuid,size=256m \
#     --security-opt no-new-privileges:true \
#     --cap-drop ALL \
#     --env-file .env \
#     -e BRANCH_NAME=Pokhara -e EDGE_PORT=7257 \
#     -p 7257:7257 \
#     -v ./certs:/app/certs:ro \
#     -v ./generated_data:/app/generated_data:ro \
#     securescore-edge
# ═══════════════════════════════════════════════════════════

FROM python:3.13-slim

LABEL maintainer="SecureScore Team"
LABEL description="Federated Learning Edge Node API (Security Hardened)"
LABEL version="3.1.0"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies for XGBoost
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libgomp1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements-edge.txt .
RUN pip install --no-cache-dir -r requirements-edge.txt

# Copy the edge node code — edge_api.py is the long-running FastAPI server,
# edge_node.py supplies the training/inference functions it imports.
COPY edge_node.py edge_api.py .
COPY models/ ./models/
COPY .env.example .

# ── Security: non-root user ──────────────────────────────
RUN groupadd -r securescore && \
    useradd -r -g securescore -d /app -s /usr/sbin/nologin securescore && \
    mkdir -p /app/edge_data /app/.ml_cache /tmp/edge && \
    chown -R securescore:securescore /app /tmp/edge

USER securescore

# BRANCH_NAME and EDGE_PORT are overridden per-edge in docker-compose.yml.
ENV BRANCH_NAME=kathmandu
ENV EDGE_PORT=7050
EXPOSE 7050

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=40s \
    CMD curl -fs "http://localhost:${EDGE_PORT}/api/health" || exit 1

# Shell form so $BRANCH_NAME / $EDGE_PORT are expanded at container start.
ENTRYPOINT []
CMD python edge_api.py --branch "$BRANCH_NAME" --port "$EDGE_PORT" --host 0.0.0.0
