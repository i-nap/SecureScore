{
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.2"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "SecureScore Federated Learning — real-time monitoring",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "FL Rounds / hour",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [{"color": "green", "value": 0}]},
          "unit": "short"
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{
        "expr": "rate(federated_rounds_total[1h]) * 3600",
        "legendFormat": "Rounds/hr",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "title": "Active Branches",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "min": 0, "max": 13,
          "thresholds": {"steps": [
            {"color": "red", "value": 0},
            {"color": "yellow", "value": 5},
            {"color": "green", "value": 10}
          ]},
          "unit": "short"
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "active_branches_count", "refId": "A"}]
    },
    {
      "id": 3,
      "title": "DP Budget Remaining",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "min": 0, "max": 10,
          "thresholds": {"steps": [
            {"color": "red", "value": 0},
            {"color": "yellow", "value": 2},
            {"color": "green", "value": 5}
          ]},
          "unit": "short"
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "dp_budget_remaining", "refId": "A"}]
    },
    {
      "id": 4,
      "title": "Auth Failures / min",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [
            {"color": "green", "value": 0},
            {"color": "yellow", "value": 5},
            {"color": "red", "value": 10}
          ]},
          "unit": "short"
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{
        "expr": "rate(auth_failures_total[1m]) * 60",
        "legendFormat": "Failures/min",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "title": "Aggregation Duration p95",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"unit": "s", "color": {"mode": "palette-classic"}}
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(aggregation_duration_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, rate(aggregation_duration_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Byzantine Rejections / 5min",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "palette-classic"}}
      },
      "targets": [{
        "expr": "rate(byzantine_rejections_total[5m]) * 300",
        "legendFormat": "Rejections/5min",
        "refId": "A"
      }]
    },
    {
      "id": 7,
      "title": "BFF Request Latency p95 (ms)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"unit": "ms", "color": {"mode": "palette-classic"}}
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"bff-gateway\"}[5m])) * 1000",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"bff-gateway\"}[5m])) * 1000",
          "legendFormat": "p50",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Model Accuracy Distribution",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {"steps": [
            {"color": "red", "value": 0},
            {"color": "yellow", "value": 0.7},
            {"color": "green", "value": 0.85}
          ]}
        }
      },
      "options": {"orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{
        "expr": "model_accuracy_distribution",
        "legendFormat": "{{branch}}",
        "refId": "A"
      }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["securescore", "federated-learning", "ml"],
  "templating": {
    "list": [{
      "current": {"selected": false, "text": "Prometheus", "value": "prometheus"},
      "hide": 0,
      "includeAll": false,
      "name": "datasource",
      "options": [],
      "query": "prometheus",
      "refresh": 1,
      "type": "datasource"
    }]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "SecureScore — Federated Learning",
  "uid": "securescore-fl-v2",
  "version": 2
}
